# Research Agent — environment template
# Copy to .env and fill values. Do not commit .env.

# --- App ---
APP_NAME=research-agent
APP_ENV=local
LOG_LEVEL=INFO
API_KEYS=dev-local-key-change-me

# --- LLM (any OpenAI-compatible provider; legacy OPENAI_* names still work) ---
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MODEL_CHEAP=gpt-4o-mini
# LLM_BASE_URL=
# Free/cheap presets (check each provider's current limits and model names):
#   Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=gemini-2.5-flash
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1
#   DeepSeek: LLM_BASE_URL=https://api.deepseek.com
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1

# --- Database ---
DATABASE_URL=postgresql+psycopg://research:research@localhost:5432/research_agent

# --- Research budgets ---
MAX_TOOL_CALLS=12
MAX_GATHER_ITERATIONS=5
MAX_RUN_MINUTES=5
MAX_SEARCH_RESULTS=5
MAX_PAGE_FETCHES=6
PAGE_FETCH_CHARS=6000
VERIFY_CLAIMS=true

# --- Tools ---
TAVILY_API_KEY=
# SERPAPI_API_KEY=
# BRAVE_SEARCH_API_KEY=

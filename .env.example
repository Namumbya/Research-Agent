# Research Agent — environment template
# Copy to .env and fill values. Do not commit .env.

# --- App ---
APP_NAME=research-agent
APP_ENV=local
LOG_LEVEL=INFO
API_KEYS=dev-local-key-change-me

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_CHEAP=gpt-4o-mini

# --- Database ---
DATABASE_URL=postgresql+asyncpg://research:research@localhost:5432/research_agent

# --- Research budgets ---
MAX_TOOL_CALLS=12
MAX_GATHER_ITERATIONS=5
MAX_RUN_MINUTES=5
MAX_SEARCH_RESULTS=5

# --- Tools ---
TAVILY_API_KEY=
# SERPAPI_API_KEY=
# BRAVE_SEARCH_API_KEY=
